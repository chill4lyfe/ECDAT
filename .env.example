ECDAT_ENV=development
ECDAT_LOG_LEVEL=INFO
ECDAT_API_HOST=0.0.0.0
ECDAT_API_PORT=8000
ECDAT_POSTGRES_DSN=postgresql+psycopg://ecdat:ecdat@localhost:5432/ecdat
ECDAT_REDIS_URL=redis://localhost:6379/0
ECDAT_NEO4J_URI=bolt://localhost:7687
ECDAT_NEO4J_USER=neo4j
ECDAT_NEO4J_PASSWORD=ecdat-development
ECDAT_QUANTUM_HORIZON_YEARS=15
NEXT_PUBLIC_ECDAT_API_BASE_URL=http://localhost:8000
ECDAT_ALLOWED_SCAN_ROOTS=/workspace,/tmp,/var/lib/ecdat/intake

ECDAT_INTAKE_DIR=/var/lib/ecdat/intake
ECDAT_MAX_UPLOAD_BYTES=536870912
ECDAT_MAX_ARCHIVE_MEMBERS=20000
ECDAT_MAX_EXTRACTED_BYTES=1073741824
