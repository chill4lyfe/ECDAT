  "relationships": [
    {"source":"edge-gateway","target":"identity-service","type":"authenticates_with"},
    {"source":"edge-gateway","target":"payments-api","type":"connects_to"},
    {"source":"payments-api","target":"settlement-service","type":"depends_on"},
    {"source":"payments-api","target":"archive-service","type":"depends_on"},
    {"source":"partner-adapter","target":"payments-api","type":"depends_on"},
    {"source":"messaging-service","target":"identity-service","type":"depends_on"},
    {"source":"analytics-service","target":"payments-api","type":"connects_to"},
    {"source":"edge-gateway","target":"partner-adapter","type":"connects_to"}
  ]
